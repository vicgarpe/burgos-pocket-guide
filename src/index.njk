---
layout: base.njk
title: "Guía de Burgos"
permalink: "/index.html"
---

{# Hero #}
<section class="mb-4">
  <div class="position-relative rounded overflow-hidden hero-frame">
    {#
      Hero en formato póster 4:5: la misma imagen y el mismo encuadre en móvil
      (a ancho completo) y en escritorio (centrado, limitado por .hero-frame).
      La master es vertical, así que no hay ningún recorte 16:9 que contenga a
      la vez las torres de la Catedral y al grupo entero.
      Variantes generadas con:
        src/images/make-hero-variants.sh src/images-master/burgos-vert.png \
          --out src/images --ratio 4:5 --widths "400 600 900" --name burgos-vert
    #}
    <picture>
      <source type="image/avif" srcset="{{ '/images/burgos-vert-400.avif' | url }} 400w, {{ '/images/burgos-vert-600.avif' | url }} 600w, {{ '/images/burgos-vert-900.avif' | url }} 900w" sizes="(max-width: 576px) 100vw, 480px">
      <source type="image/webp" srcset="{{ '/images/burgos-vert-400.webp' | url }} 400w, {{ '/images/burgos-vert-600.webp' | url }} 600w, {{ '/images/burgos-vert-900.webp' | url }} 900w" sizes="(max-width: 576px) 100vw, 480px">
      <img
        src="{{ '/images/burgos-vert-600.jpg' | url }}"
        srcset="{{ '/images/burgos-vert-400.jpg' | url }} 400w, {{ '/images/burgos-vert-600.jpg' | url }} 600w, {{ '/images/burgos-vert-900.jpg' | url }} 900w"
        sizes="(max-width: 576px) 100vw, 480px"
        alt="El grupo con las maletas junto al coche en una calle empedrada, con la Catedral de Burgos y los tejados del casco antiguo al atardecer"
        class="w-100 d-block hero-img"
        width="900" height="1125"
        fetchpriority="high"
      >
    </picture>
    <div class="hero-caption">
      Burgos en 3 días: casco histórico, Atapuerca y vuelta sin prisa.
    </div>
  </div>
</section>

{# Intro desde portada.md #}
<section class="portada-intro mb-5">
  {{ collections.portada[0].content | safe }}
</section>

{# Agenda #}
<h2 class="module-title mb-4">Agenda</h2>
<div class="row g-4">
  {% for post in collections.agenda %}
    <div class="col-12 col-md-6 col-lg-4">
      <a href="{{ post.url | url }}" class="post-card-link d-block h-100 text-decoration-none text-reset">
        <article class="card h-100 shadow-sm">
          <div class="ratio ratio-16x9">
            {% if post.data.hero %}
              <img src="{{ post.data.hero | url }}" class="card-img-top object-fit-cover" alt="{{ post.data.alt or post.data.title }}" loading="lazy">
            {% else %}
              <img src="https://picsum.photos/800/500?{{ loop.index }}" class="card-img-top object-fit-cover" alt="Imagen" loading="lazy">
            {% endif %}
          </div>
          <div class="card-body">
            <h3 class="h5 card-title">{{ post.data.title }}</h3>
            {% if post.data.excerpt %}
              <p class="card-text text-secondary">{{ post.data.excerpt }}</p>
            {% endif %}
          </div>
          <div class="card-footer bg-white small text-muted">
            {{ post.date | formatDateFull('es-ES') }}
          </div>
        </article>
      </a>
    </div>
  {% endfor %}
</div>
