---
layout: base.njk
---
{% if modulo == "Historia" %}
  {% set volverUrl = '/historia/' %}{% set volverTxt = 'Historia' %}
{% elif modulo == "Recursos" %}
  {% set volverUrl = '/recursos/' %}{% set volverTxt = 'Recursos' %}
{% else %}
  {% set volverUrl = '/' %}{% set volverTxt = 'la guía' %}
{% endif %}

<nav class="ficha-nav ficha-nav-top" aria-label="Volver">
  <a href="{{ volverUrl | url }}" class="ficha-nav-link">&lsaquo; {{ volverTxt | capitalize }}</a>
</nav>

<article class="row g-4 align-items-stretch">
  {% if hero %}
    <div class="col-12 col-lg-7">
      <figure class="ratio ratio-16x9 d-block rounded overflow-hidden">
        <img
          src="{{ hero | url }}"
          class="w-100 h-100"
          style="object-fit:cover"
          alt="{{ alt or title }}"
          loading="lazy"
        >
      </figure>
    </div>
  {% endif %}

  <div class="col-12 col-lg-5 d-flex">
    <div class="d-flex flex-column">
      <h2 class="post-title lh-sm">{{ title }}</h2>
      {% if excerpt %}
        <p class="text-secondary lead">{{ excerpt }}</p>
      {% endif %}
      <div class="mt-auto small text-muted">
        {% if modulo %}
          <span class="module-badge">{{ modulo }}</span>
        {% else %}
          {{ page.date | formatDateFull('es-ES') }}
        {% endif %}
      </div>
    </div>
  </div>
</article>

<div class="mt-4 content">
  {{ content | safe }}
</div>

<nav class="ficha-nav ficha-nav-bottom" aria-label="Navegación de la ficha">
  <a href="{{ volverUrl | url }}" class="ficha-nav-btn">&lsaquo; Volver a {{ volverTxt }}</a>
  {% if volverUrl != '/' %}
    <a href="{{ '/' | url }}" class="ficha-nav-btn">Inicio de la guía</a>
  {% endif %}
  <a href="#" class="ficha-nav-btn ficha-nav-top-link">&uarr; Arriba</a>
</nav>
